{
  "expo": {
    "name": "Bloomi",
    "slug": "bloomi-app",
    "version": "1.1.11",
    "scheme": "bloomi",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloomi a besoin d'accéder à vos photos pour sélectionner des images des articles que vous vendez. Par exemple, choisissez des photos d'une veste, d'une robe ou de chaussures pour votre annonce.",
          "cameraPermission": "Bloomi a besoin d'accéder à votre appareil photo pour photographier les articles que vous vendez. Par exemple, prenez en photo une veste, une robe ou des chaussures pour créer une annonce."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.jupouch.bloomiapp",
          "enableGooglePay": true,
          "urlScheme": "bloomi"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C3EA4F",
          "image": "./assets/brand/splash-screen.png",
          "enableFullScreenImage_legacy": true,
          "resizeMode": "contain",
          "ios": {
            "backgroundColor": "#C3EA4F",
            "image": "./assets/brand/splash-screen.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "contain"
          },
          "android": {
            "backgroundColor": "#C3EA4F",
            "image": "./assets/brand/splash-screen.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "contain"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "icon": "./assets/b.png",
    "splash": {
      "backgroundColor": "#C3EA4F",
      "image": "./assets/brand/splash-screen.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "6e1bb048-f2d6-4907-99b6-f8c631fe594e"
      },
      "router": {}
    },
    "owner": "jupouch",
    "android": {
      "package": "com.jupouch.bloomiapp",
      "versionCode": 33,
      "softwareKeyboardLayoutMode": "pan",
      "splash": {
        "backgroundColor": "#C3EA4F",
        "image": "./assets/brand/splash-screen.png",
        "resizeMode": "contain"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground.png",
        "backgroundColor": "#C3EA4F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bloomi.ch",
              "pathPrefix": "/dressing"
            },
            {
              "scheme": "https",
              "host": "bloomi.ch",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "https",
              "host": "www.bloomi.ch",
              "pathPrefix": "/dressing"
            },
            {
              "scheme": "https",
              "host": "www.bloomi.ch",
              "pathPrefix": "/listing"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "auth",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "profile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "stripe-redirect"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "listing",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "dressing",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon-expo.png"
    },
    "ios": {
      "bundleIdentifier": "com.jupouch.bloomiapp",
      "buildNumber": "97",
      "associatedDomains": [
        "applinks:bloomi.ch",
        "applinks:www.bloomi.ch"
      ],
      "icon": "./assets/app-icon/icon-1024.png",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Bloomi a besoin d'accéder à votre appareil photo pour photographier les articles que vous vendez. Par exemple, prenez en photo une veste, une robe ou des chaussures pour créer une annonce.",
        "NSPhotoLibraryUsageDescription": "Bloomi a besoin d'accéder à vos photos pour sélectionner des images des articles que vous vendez. Par exemple, choisissez des photos d'une veste, d'une robe ou de chaussures pour votre annonce.",
        "NSPhotoLibraryAddUsageDescription": "Bloomi enregistre les images dans votre photothèque lorsque vous téléchargez des photos d'annonces.",
        "NSLocationWhenInUseUsageDescription": "Bloomi a besoin d'accéder à votre position pour afficher les annonces près de chez vous.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Bloomi a besoin d'accéder à votre position pour afficher les annonces près de chez vous.",
        "NSLocationAlwaysUsageDescription": "Bloomi a besoin d'accéder à votre position pour afficher les annonces près de chez vous.",
        "NSMicrophoneUsageDescription": "Bloomi a besoin d'accéder au microphone pour cette fonctionnalité."
      }
    }
  }
}
