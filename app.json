{
  "expo": {
    "name": "Bloomi",
    "slug": "bloomi-app",
    "scheme": "bloomi",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.jupouch.bloomiapp",
          "urlScheme": "bloomi"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "icon": "./assets/icon-fullsize.png",
    "splash": {
      "backgroundColor": "#ffffff",
      "image": "./assets/icon-fullsize.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "6e1bb048-f2d6-4907-99b6-f8c631fe594e"
      },
      "router": {}
    },
    "owner": "jupouch",
    "android": {
      "package": "com.jupouch.bloomiapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-fullsize.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "auth",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jupouch.bloomiapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Bloomi uses your camera to take photos of items you want to sell on the marketplace.",
        "NSPhotoLibraryUsageDescription": "Bloomi uses your photo library to select photos of items you want to sell on the marketplace.",
        "NSPhotoLibraryAddUsageDescription": "Bloomi saves photos to your library when you download listing images."
      }
    }
  }
}
