{
  "expo": {
    "name": "Bloomi",
    "slug": "bloomi-app",
    "version": "0.1.1",
    "scheme": "bloomi",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloomi needs access to your photo library to let you select photos of items you want to sell. For example, choose existing photos of a jacket, dress, or shoes to add to your listing.",
          "cameraPermission": "Bloomi needs access to your camera to take photos of items you want to sell. For example, photograph a jacket, dress, or pair of shoes to create a new listing."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.jupouch.bloomiapp",
          "urlScheme": "bloomi"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C3EA4F",
          "image": "./assets/brand/logo-bloomi.png",
          "imageWidth": 280,
          "resizeMode": "contain"
        }
      ]
    ],
    "icon": "./assets/b.png",
    "splash": {
      "backgroundColor": "#C3EA4F",
      "image": "./assets/brand/logo-bloomi.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "6e1bb048-f2d6-4907-99b6-f8c631fe594e"
      },
      "router": {}
    },
    "owner": "jupouch",
    "android": {
      "package": "com.jupouch.bloomiapp",
      "versionCode": 2,
      "splash": {
        "backgroundColor": "#C3EA4F",
        "image": "./assets/brand/logo-bloomi.png",
        "resizeMode": "contain"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground.png",
        "backgroundColor": "#121212"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "auth",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bloomi",
              "host": "profile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon-expo.png"
    },
    "ios": {
      "bundleIdentifier": "com.jupouch.bloomiapp",
      "buildNumber": "8",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Bloomi needs access to your camera to take photos of items you want to sell. For example, photograph a jacket, dress, or pair of shoes to create a new listing.",
        "NSPhotoLibraryUsageDescription": "Bloomi needs access to your photo library to let you select photos of items you want to sell. For example, choose existing photos of a jacket, dress, or shoes to add to your listing.",
        "NSPhotoLibraryAddUsageDescription": "Bloomi saves photos to your library when you download listing images."
      }
    }
  }
}
