# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Ne committez jamais .env / .env.local / .env.staging.

# Environnement (development | staging | production)
# En local, souvent inutile (__DEV__). Pour EAS : défini via eas.json / secrets.
# EXPO_PUBLIC_ENV=development

# --- Supabase (app mobile) ---
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# --- Stripe (clé publique uniquement côté app) ---
# Dev / Expo Go : pk_test_... | TestFlight / prod : pk_live_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- URLs de partage (prod bloomi.ch) ---
EXPO_PUBLIC_LISTING_SHARE_URL=https://bloomi.ch/listing/{id}
EXPO_PUBLIC_CLOSET_SHARE_URL=https://bloomi.ch/dressing/{id}

# --- Debug auth (optionnel, local only) ---
# EXPO_PUBLIC_AUTH_DEBUG=1

# =============================================================================
# Variables serveur uniquement (NE PAS mettre dans l'app / EAS EXPO_PUBLIC_*)
# À configurer dans Supabase → Edge Functions → Secrets, ou en local pour scripts :
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# STRIPE_SECRET_KEY=sk_...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Bloomi <contact@bloomi.ch>
# PUBLIC_SHARE_BASE_URL=https://bloomi.ch
# CRON_SECRET=...
# POST_CH_LICENCE=...
# POST_CH_LETTER_APLUS_LICENCE=...
