# Logs auth détaillés (OAuth, callbacks) — filtre Metro : [AuthDebug
# EXPO_PUBLIC_AUTH_DEBUG=1

# Copiez ce fichier vers .env.local et remplissez les valeurs

# Environnement (development/staging/production)
# En dÃ©veloppement local, cette variable n'est pas nÃ©cessaire (utilise __DEV__)
# Pour les builds EAS, elle est dÃ©finie automatiquement via eas.json
# EXPO_PUBLIC_ENV=development

# Supabase - Configuration de dÃ©veloppement
# Remplacez par les valeurs de votre projet Supabase de dÃ©veloppement
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet-dev.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-dev

# URL de partage (production — bloomi.ch proxy vers Supabase Edge Functions).
# Valeurs recommandées en prod :
EXPO_PUBLIC_LISTING_SHARE_URL=https://bloomi.ch/listing/{id}
EXPO_PUBLIC_CLOSET_SHARE_URL=https://bloomi.ch/dressing/{id}
#
# Secret Edge Functions (Supabase → Edge Functions → Secrets) :
#   PUBLIC_SHARE_BASE_URL=https://bloomi.ch
# Config serveur Apache : deploy/bloomi-share-proxy/apache-bloomi-share.conf

# Stripe — clé publique (obligatoire pour le paiement in-app)
# Dev / Expo Go : pk_test_... | TestFlight / prod : pk_live_...
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Builds EAS (TestFlight, Play Store) : les variables EXPO_PUBLIC_* doivent être
# sur l’environnement EAS (production / preview), visibilité plaintext ou sensitive
# (pas "secret" — sinon elles ne sont pas incluses dans le bundle JS).
#
#   eas env:create production --name EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY --value "pk_live_..." --visibility plaintext
#   eas env:create production --name EXPO_PUBLIC_SUPABASE_URL --value "https://..."
#   eas env:create production --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "eyJ..."
#
# Puis rebuild : eas build --platform ios --profile production
#
# STRIPE_SECRET_KEY (sk_live_...) : uniquement dans Supabase → Edge Functions → Secrets,
# pas dans EAS (inutile pour l'app mobile).
#
# Resend — clé API pour les e-mails transactionnels (étiquettes La Poste, ventes, offres, rappels…)
# Supabase → Edge Functions → Secrets :
#   POST_CH_LICENCE=60184254                (licence colis / valeur par défaut)
#   POST_CH_LETTER_APLUS_LICENCE=174291     (licence dédiée Lettre A+)
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=Bloomi <contact@bloomi.ch>  (optionnel)
#   CRON_SECRET=...  (pour process-delayed-emails via pg_cron)
# Planification cron : supabase/scripts/schedule_delayed_emails.sql
#
# Backfill images feed (scripts/backfill-listing-card-images.mjs) — local only:
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...   (Dashboard → Settings → API → service_role)
#   npm run images:backfill-cards
